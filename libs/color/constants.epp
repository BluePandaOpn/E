@package "color.constants"

// Codigos ANSI de formato.
func RESET() { return "\033[0m" }
func BOLD() { return "\033[1m" }
func DIM() { return "\033[2m" }
func UNDERLINE() { return "\033[4m" }

// Colores de texto (foreground).
func ROJO() { return "\033[31m" }
func VERDE() { return "\033[32m" }
func AZUL() { return "\033[34m" }
func AMARILLO() { return "\033[33m" }
func MAGENTA() { return "\033[35m" }
func CYAN() { return "\033[36m" }
func BLANCO() { return "\033[37m" }

// Colores de fondo (background).
func BG_ROJO() { return "\033[41m" }
func BG_VERDE() { return "\033[42m" }
func BG_AZUL() { return "\033[44m" }
func BG_AMARILLO() { return "\033[43m" }
func BG_MAGENTA() { return "\033[45m" }
func BG_CYAN() { return "\033[46m" }
func BG_BLANCO() { return "\033[47m" }
