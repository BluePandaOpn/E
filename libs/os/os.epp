import _native

func getcwd() {
    return os_getcwd()
}

func cwd() {
    return getcwd()
}

func exists(path) {
    return os_exists(path)
}

func is_file(path) {
    return os_is_file(path)
}

func is_dir(path) {
    return os_is_dir(path)
}

func mkdir(path) {
    return os_mkdir(path)
}

func makedirs(path) {
    return mkdir(path)
}

func remove(path) {
    return os_remove(path)
}

func unlink(path) {
    return remove(path)
}

func ensure_dir(path) {
    if exists(path) {
        return is_dir(path)
    }
    return mkdir(path)
}

func remove_if_exists(path) {
    if not exists(path) {
        return true
    }
    return remove(path)
}

// Extensiones utilitarias
func join2(a, b) {
    return a + "/" + b
}

func join3(a, b, c) {
    return join2(join2(a, b), c)
}

func join4(a, b, c, d) {
    return join2(join3(a, b, c), d)
}

func pwd() {
    return getcwd()
}

func module_name() {
    return "stdlib.os"
}

func module_version() {
    return "2.0.0"
}

func native_runtime() {
    return _native.runtime_name()
}

func native_builtin_mode() {
    return _native.builtin_mode()
}