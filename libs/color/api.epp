@package "color.api"

from color.compose import colorize, paint
from color.rgb import rgb, bg_rgb
from color.printing import print_color

class ColorAPI {
    func text(texto, fg) {
        return paint(texto, fg)
    }

    func style(texto, fg, bg, bold, underline, dim) {
        return colorize(texto, fg, bg, bold, underline, dim)
    }

    func text_rgb(texto, r, g, b) {
        return rgb(texto, r, g, b)
    }

    func bg_text_rgb(texto, r, g, b) {
        return bg_rgb(texto, r, g, b)
    }

    func out(texto, fg) {
        print_color(texto, fg)
    }
}

func Color() {
    return ColorAPI()
}
