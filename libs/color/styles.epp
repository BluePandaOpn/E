@package "color.styles"

from color.palette import instancia

func negrita(t) {
    var c = instancia()
    return c.estilo(t, "", c.bold)
}

func subrayado(t) {
    var c = instancia()
    return c.estilo(t, "", c.underline)
}

func tenue(t) {
    var c = instancia()
    return c.estilo(t, "", c.dim)
}

func alerta(t) {
    var c = instancia()
    return c.estilo(t, c.rojo, c.bold)
}

func exito(t) {
    var c = instancia()
    return c.estilo(t, c.verde, c.bold)
}

func info(t) {
    var c = instancia()
    return c.estilo(t, c.cyan, c.bold)
}
