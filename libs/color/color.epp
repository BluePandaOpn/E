@package "color.color"

import color.constants

// Nucleo orientado a objetos para aplicar codigos ANSI.
class ConsolaColor {
    func init() {
        this.reset = RESET()
        this.bold = BOLD()
        this.dim = DIM()
        this.underline = UNDERLINE()

        this.rojo = ROJO()
        this.verde = VERDE()
        this.azul = AZUL()
        this.amarillo = AMARILLO()
        this.magenta = MAGENTA()
        this.cyan = CYAN()
        this.blanco = BLANCO()

        this.bg_rojo = BG_ROJO()
        this.bg_verde = BG_VERDE()
        this.bg_azul = BG_AZUL()
        this.bg_amarillo = BG_AMARILLO()
        this.bg_magenta = BG_MAGENTA()
        this.bg_cyan = BG_CYAN()
        this.bg_blanco = BG_BLANCO()
    }

    func colorear(texto, color_codigo) {
        return color_codigo + texto + this.reset
    }

    func estilo(texto, color_codigo, extra_codigo) {
        return extra_codigo + color_codigo + texto + this.reset
    }
}

func strip_ansi(t) {
    // Placeholder de compatibilidad: pendiente regex nativo en runtime.
    return t
}
