// Fuente principal modular de la libreria _native.
// Mantiene la misma API que el archivo raiz para facilitar migracion.

func builtin_mode() {
    return true
}

func runtime_name() {
    return "native_std_cpp"
}

func module_name() {
    return "_native"
}

func module_version() {
    return "2.1.0"
}

func api_version() {
    return "2026.1"
}

func is_stable() {
    return true
}

func build_target() {
    return "builtin"
}

func health_check() {
    return "ok"
}

func diagnostics_hint() {
    return "epp doctor --imports"
}

func capabilities_text() {
    return "builtin_mode,runtime_name,module_name,module_version,api_version,is_stable,build_target,health_check,diagnostics_hint"
}
