import _native

func getcwd() {
    return os_getcwd()
}

func cwd() {
    return getcwd()
}

func exists(path) {
    return os_exists(path)
}

func is_file(path) {
    return os_is_file(path)
}

func is_dir(path) {
    return os_is_dir(path)
}

func mkdir(path) {
    return os_mkdir(path)
}

func makedirs(path) {
    return mkdir(path)
}

func remove(path) {
    return os_remove(path)
}

func unlink(path) {
    return remove(path)
}


