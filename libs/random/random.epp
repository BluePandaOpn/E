import _native

func seed(n) {
    return random_seed(n)
}

func reseed() {
    return random_seed()
}

func random() {
    return random_random()
}

func randint(a, b) {
    return random_randint(a, b)
}

func uniform(a, b) {
    return random_uniform(a, b)
}

func randrange(stop) {
    return randint(0, stop - 1)
}

func randrange2(start, stop) {
    return randint(start, stop - 1)
}

func randrange_step(start, stop, step) {
    var n = randrange2(start, stop)
    var k = int((n - start) / step)
    return start + (k * step)
}

// Extensiones utilitarias
func randbool() {
    return randint(0, 1) == 1
}

func chance(percent) {
    return randint(1, 100) <= percent
}

func rand01() {
    return random()
}

func coinflip() {
    return randbool()
}

func random_sign() {
    if randbool() { return 1 }
    return -1
}

func random_unit() {
    return uniform(-1, 1)
}

func module_name() {
    return "stdlib.random"
}

func module_version() {
    return "2.0.0"
}

func native_runtime() {
    return _native.runtime_name()
}

func native_builtin_mode() {
    return _native.builtin_mode()
}