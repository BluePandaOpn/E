import _native

func time() {
    return time_time()
}

func now() {
    return time()
}

func monotonic() {
    return time_monotonic()
}

func sleep(seconds) {
    return time_sleep(seconds)
}

func sleep_ms(milliseconds) {
    return sleep(milliseconds / 1000)
}



// Extensiones utilitarias
func sleep_seconds(seconds) {
    return sleep(seconds)
}

func sleep_minutes(minutes) {
    return sleep(minutes * 60)
}

func elapsed(start, finish) {
    return finish - start
}
