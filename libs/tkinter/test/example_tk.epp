import tkinter

func main() {
    var root = tk.screen("Panel de tareas (E++)", 760, 460)

    if not root.ensure(760, 460) {
        print("tkinter no disponible en este runtime")
        return
    }

    tk.print_line(root, "Panel de tareas del dia")
    tk.print_line(root, "Proyecto: Organizar semana")
    var inp = tk.input_line(root, "Usuario:", "Admin")
    var out = tk.output_line(root, "Salida: listo")
    var btn = tk.button_line(root, "Procesar")

    tk.mainloop(root)

    if tk.clicked(root, btn) {
        tk.set_output(root, out, "Salida: avance marcado por " + tk.get(root, inp))
        print(tk.get(root, out))
    }
}

main()
