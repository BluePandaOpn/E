import _native

var pi = math_pi()
var e = math_e()
var tau = pi * 2

func sqrt(x) { return math_sqrt(x) }
func pow(a, b) { return math_pow(a, b) }
func floor(x) { return math_floor(x) }
func ceil(x) { return math_ceil(x) }
func sin(x) { return math_sin(x) }
func cos(x) { return math_cos(x) }
func tan(x) { return math_tan(x) }
func log(x) { return math_log(x) }
func exp(x) { return math_exp(x) }

func abs(x) {
    if x < 0 {
        return 0 - x
    }
    return x
}

func min(a, b) {
    if a < b { return a }
    return b
}

func max(a, b) {
    if a > b { return a }
    return b
}

func clamp(x, low, high) {
    return max(low, min(x, high))
}

func sign(x) {
    if x > 0 { return 1 }
    if x < 0 { return -1 }
    return 0
}

func square(x) {
    return x * x
}

func cube(x) {
    return x * x * x
}

func radians(deg) {
    return deg * (pi / 180)
}

func degrees(rad) {
    return rad * (180 / pi)
}

func hypot2(x, y) {
    return sqrt((x * x) + (y * y))
}

func distance2d(x1, y1, x2, y2) {
    var dx = x2 - x1
    var dy = y2 - y1
    return hypot2(dx, dy)
}

func average2(a, b) {
    return (a + b) / 2
}

func average3(a, b, c) {
    return (a + b + c) / 3
}

func frac(x) {
    return x - floor(x)
}

func lerp(a, b, t) {
    return a + ((b - a) * t)
}

func inv_lerp(a, b, value) {
    var den = b - a
    if den == 0 { return 0 }
    return (value - a) / den
}

func map_range(value, in_min, in_max, out_min, out_max) {
    var t = inv_lerp(in_min, in_max, value)
    return lerp(out_min, out_max, t)
}

func is_close(a, b, rel_tol, abs_tol) {
    var diff = abs(a - b)
    if diff <= abs_tol {
        return true
    }
    var limit = rel_tol * max(abs(a), abs(b))
    return diff <= limit
}

func round(x) {
    if x >= 0 {
        return floor(x + 0.5)
    }
    return ceil(x - 0.5)
}

func between(x, low, high) {
    return x >= low and x <= high
}

func clamp01(x) {
    return clamp(x, 0, 1)
}

func normalize_range(value, low, high) {
    return clamp01(inv_lerp(low, high, value))
}

func module_name() {
    return "stdlib.math"
}

func module_version() {
    return "2.1.0"
}

func native_runtime() {
    return _native.runtime_name()
}

func native_builtin_mode() {
    return _native.builtin_mode()
}
