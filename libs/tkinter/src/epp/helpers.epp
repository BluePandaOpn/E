@package "tkinter.src.epp.helpers"

from tkinter.src.epp.core import TkApp, is_available
from tkinter.src.epp.runtime import native_runtime, native_builtin_mode

func Tk() {
    return TkApp("E++ App")
}

func app(title) {
    return TkApp(title)
}

func window(title) {
    return app(title)
}

func create_app(title) {
    return app(title)
}

func can_use() {
    return is_available()
}

func create_window(title, width, height) {
    var a = TkApp(title)
    a.create(width, height)
    return a
}

func run(title, width, height) {
    var a = TkApp(title)
    if not a.create(width, height) {
        return false
    }
    return a.mainloop()
}

func simple(title, text) {
    var a = TkApp(title)
    if not a.create(480, 220) {
        return false
    }
    a.label_line(text)
    a.button_line("Cerrar")
    return a.mainloop()
}

func demo(title) {
    var a = TkApp(title)
    if not a.create(640, 420) {
        return false
    }
    a.label("E++ Tk Native (C++)", 16, 16, 260, 24)
    a.button("Cerrar", 16, 52, 120, 28)
    return a.mainloop()
}

func screen(title, width, height) {
    return create_window(title, width, height)
}

class TkNamespace {
    func available() {
        return is_available()
    }

    func can_use() {
        return is_available()
    }

    func app(title) {
        return TkApp(title)
    }

    func Tk() {
        return TkApp("E++ App")
    }

    func window(title) {
        return TkApp(title)
    }

    func create_app(title) {
        return TkApp(title)
    }

    func create_window(title, width, height) {
        var a = TkApp(title)
        a.create(width, height)
        return a
    }

    func screen(title, width, height) {
        var a = TkApp(title)
        a.create(width, height)
        return a
    }

    func run(title, width, height) {
        var a = TkApp(title)
        if not a.create(width, height) {
            return false
        }
        return a.mainloop()
    }

    func simple(title, text) {
        var a = TkApp(title)
        if not a.create(480, 220) {
            return false
        }
        a.label_line(text)
        a.button_line("Cerrar")
        return a.mainloop()
    }

    func demo(title) {
        var a = TkApp(title)
        if not a.create(640, 420) {
            return false
        }
        a.label("E++ Tk Native (C++)", 16, 16, 260, 24)
        a.button("Cerrar", 16, 52, 120, 28)
        return a.mainloop()
    }

    func label(ui, text, x, y, w, h) {
        return ui.label(text, x, y, w, h)
    }

    func Label(ui, text, x, y, w, h) {
        return ui.label(text, x, y, w, h)
    }

    func button(ui, text, x, y, w, h) {
        return ui.button(text, x, y, w, h)
    }

    func Button(ui, text, x, y, w, h) {
        return ui.button(text, x, y, w, h)
    }

    func entry(ui, text, x, y, w, h) {
        return ui.entry(text, x, y, w, h)
    }

    func Entry(ui, text, x, y, w, h) {
        return ui.entry(text, x, y, w, h)
    }

    func input(ui, text, x, y, w, h) {
        return ui.entry(text, x, y, w, h)
    }

    func click(ui, button_id) {
        return ui.button_clicked(button_id)
    }

    func clicked(ui, button_id) {
        return ui.button_clicked(button_id)
    }

    func label_line(ui, text) {
        return ui.label_line(text)
    }

    func button_line(ui, text) {
        return ui.button_line(text)
    }

    func entry_line(ui, text) {
        return ui.entry_line(text)
    }

    func get(ui, widget_id) {
        return ui.get_text(widget_id)
    }

    func set(ui, widget_id, text) {
        return ui.set_text(widget_id, text)
    }

    func get_value(ui, widget_id) {
        return ui.get_text(widget_id)
    }

    func set_value(ui, widget_id, text) {
        return ui.set_text(widget_id, text)
    }

    func show(ui) {
        return ui.show()
    }

    func mainloop(ui) {
        return ui.mainloop()
    }

    func geometry(ui, width, height) {
        return ui.geometry(width, height)
    }

    func title(ui, text) {
        return ui.title(text)
    }

    func bg(ui, color_hex) {
        return ui.set_bg(color_hex)
    }

    func fg(ui, color_hex) {
        return ui.set_fg(color_hex)
    }

    func accent(ui, color_hex) {
        return ui.set_accent(color_hex)
    }

    func apply_scss(ui, path) {
        return ui.apply_scss(path)
    }

    func theme(ui, bg_hex, fg_hex, accent_hex) {
        return ui.theme(bg_hex, fg_hex, accent_hex)
    }

    func apply_theme(ui, bg_hex, fg_hex, accent_hex) {
        return ui.theme(bg_hex, fg_hex, accent_hex)
    }

    func input_line(ui, label_text, default_text) {
        return ui.input_line(label_text, default_text)
    }

    func print_line(ui, text) {
        return ui.print_line(text)
    }

    func output_line(ui, text) {
        return ui.output_line(text)
    }

    func set_output(ui, widget_id, text) {
        return ui.set_output(widget_id, text)
    }

    func get_input(ui, widget_id) {
        return ui.get_input(widget_id)
    }

    func button_line_ex(ui, text, w) {
        return ui.button_line_ex(text, w)
    }

    func interact(ui, button_id) {
        return ui.interact(button_id)
    }

    func runtime() {
        return native_runtime()
    }

    func builtin_mode() {
        return native_builtin_mode()
    }
}
