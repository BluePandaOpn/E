@package "color"

import _native

// Libreria ANSI color para consola.
class ConsolaColor {
    func init() {
        this.reset = "\033[0m"
        this.bold = "\033[1m"
        this.dim = "\033[2m"
        this.underline = "\033[4m"
        this.rojo = "\033[31m"
        this.verde = "\033[32m"
        this.azul = "\033[34m"
        this.amarillo = "\033[33m"
        this.magenta = "\033[35m"
        this.cyan = "\033[36m"
        this.blanco = "\033[37m"

        this.bg_rojo = "\033[41m"
        this.bg_verde = "\033[42m"
        this.bg_azul = "\033[44m"
        this.bg_amarillo = "\033[43m"
        this.bg_magenta = "\033[45m"
        this.bg_cyan = "\033[46m"
        this.bg_blanco = "\033[47m"
    }

    func colorear(texto, color_codigo) {
        return color_codigo + texto + this.reset
    }

    func estilo(texto, color_codigo, extra_codigo) {
        return extra_codigo + color_codigo + texto + this.reset
    }
}

// Instancia global para facilitar el uso desde el paquete
var c = ConsolaColor()

func rojo(t) { return c.colorear(t, c.rojo) }
func verde(t) { return c.colorear(t, c.verde) }
func azul(t) { return c.colorear(t, c.azul) }
func amarillo(t) { return c.colorear(t, c.amarillo) }
func magenta(t) { return c.colorear(t, c.magenta) }
func cyan(t) { return c.colorear(t, c.cyan) }
func blanco(t) { return c.colorear(t, c.blanco) }

func bg_rojo(t) { return c.colorear(t, c.bg_rojo) }
func bg_verde(t) { return c.colorear(t, c.bg_verde) }
func bg_azul(t) { return c.colorear(t, c.bg_azul) }
func bg_amarillo(t) { return c.colorear(t, c.bg_amarillo) }
func bg_magenta(t) { return c.colorear(t, c.bg_magenta) }
func bg_cyan(t) { return c.colorear(t, c.bg_cyan) }
func bg_blanco(t) { return c.colorear(t, c.bg_blanco) }

func negrita(t) { return c.estilo(t, "", c.bold) }
func subrayado(t) { return c.estilo(t, "", c.underline) }
func alerta(t) { return c.estilo(t, c.rojo, c.bold) }
func exito(t) { return c.estilo(t, c.verde, c.bold) }
func info(t) { return c.estilo(t, c.cyan, c.bold) }

func strip_ansi(t) {
    // El runtime no expone reemplazo regex todavia, devolvemos el texto tal cual.
    // Este helper existe para compatibilidad futura.
    return t
}

func native_runtime() {
    return _native.runtime_name()
}

func native_builtin_mode() {
    return _native.builtin_mode()
}
