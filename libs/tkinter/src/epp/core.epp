@package "tkinter.src.epp.core"

import _native

func available() {
    return tkinter_available()
}

func is_available() {
    return available()
}

class TkApp {
    func init(title) {
        this.app_title = title
        this.ready = available()
        this.window_id = -1
        this.default_w = 640
        this.default_h = 420
        this.cursor_y = 16
        this.row_h = 34
    }

    func ok() {
        return this.ready
    }

    func created() {
        return this.window_id > 0
    }

    func create(width, height) {
        if not this.ready {
            return false
        }
        this.default_w = int(width)
        this.default_h = int(height)
        this.cursor_y = 16
        this.window_id = int(tkinter_window_create(this.app_title, width, height))
        return this.window_id > 0
    }

    func ensure(width, height) {
        if this.window_id > 0 {
            return true
        }
        return this.create(width, height)
    }

    func title(text) {
        if this.window_id <= 0 {
            return false
        }
        this.app_title = text
        return tkinter_window_set_title(this.window_id, text)
    }

    func set_title(text) {
        return this.title(text)
    }

    func geometry(width, height) {
        this.default_w = int(width)
        this.default_h = int(height)
        if this.window_id > 0 {
            return true
        }
        return this.create(width, height)
    }

    func label(text, x, y, w, h) {
        if this.window_id <= 0 {
            return -1
        }
        return int(tkinter_label_add(this.window_id, text, x, y, w, h))
    }

    func Label(text, x, y, w, h) {
        return this.label(text, x, y, w, h)
    }

    func lbl(text, x, y, w, h) {
        return this.label(text, x, y, w, h)
    }

    func button(text, x, y, w, h) {
        if this.window_id <= 0 {
            return -1
        }
        return int(tkinter_button_add(this.window_id, text, x, y, w, h))
    }

    func Button(text, x, y, w, h) {
        return this.button(text, x, y, w, h)
    }

    func btn(text, x, y, w, h) {
        return this.button(text, x, y, w, h)
    }

    func entry(text, x, y, w, h) {
        if this.window_id <= 0 {
            return -1
        }
        return int(tkinter_entry_add(this.window_id, text, x, y, w, h))
    }

    func Entry(text, x, y, w, h) {
        return this.entry(text, x, y, w, h)
    }

    func input(text, x, y, w, h) {
        return this.entry(text, x, y, w, h)
    }

    func button_clicked(button_id) {
        if this.window_id <= 0 {
            return 0
        }
        return int(tkinter_button_clicked(this.window_id, button_id))
    }

    func clicked(button_id) {
        return this.button_clicked(button_id)
    }

    func click(button_id) {
        return this.button_clicked(button_id)
    }

    func set_text(widget_id, text) {
        if this.window_id <= 0 {
            return false
        }
        return tkinter_widget_set_text(this.window_id, widget_id, text)
    }

    func get_text(widget_id) {
        if this.window_id <= 0 {
            return ""
        }
        return tkinter_widget_get_text(this.window_id, widget_id)
    }

    func set_value(widget_id, text) {
        return this.set_text(widget_id, text)
    }

    func get_value(widget_id) {
        return this.get_text(widget_id)
    }

    func set_bg(color_hex) {
        if this.window_id <= 0 {
            return false
        }
        return tkinter_window_set_bg(this.window_id, color_hex)
    }

    func set_fg(color_hex) {
        if this.window_id <= 0 {
            return false
        }
        return tkinter_window_set_fg(this.window_id, color_hex)
    }

    func set_accent(color_hex) {
        if this.window_id <= 0 {
            return false
        }
        return tkinter_window_set_accent(this.window_id, color_hex)
    }

    func apply_scss(path) {
        if this.window_id <= 0 {
            return false
        }
        return tkinter_window_apply_scss(this.window_id, path)
    }

    func show() {
        if this.window_id <= 0 {
            return false
        }
        tkinter_window_show(this.window_id)
        return true
    }

    func line_break(h) {
        this.cursor_y = this.cursor_y + int(h)
        return this.cursor_y
    }

    func label_line(text) {
        var id = this.label(text, 16, this.cursor_y, this.default_w - 32, 24)
        this.cursor_y = this.cursor_y + this.row_h
        return id
    }

    func lbl_line(text) {
        return this.label_line(text)
    }

    func button_line(text) {
        var id = this.button(text, 16, this.cursor_y, 160, 28)
        this.cursor_y = this.cursor_y + this.row_h
        return id
    }

    func entry_line(text) {
        var id = this.entry(text, 16, this.cursor_y, this.default_w - 32, 28)
        this.cursor_y = this.cursor_y + this.row_h
        return id
    }

    func btn_line(text) {
        return this.button_line(text)
    }

    func mainloop() {
        if this.ready {
            if this.window_id <= 0 {
                this.window_id = int(tkinter_window_create(this.app_title, this.default_w, this.default_h))
            }
            if this.window_id <= 0 {
                print("no se pudo crear ventana nativa")
                return false
            }
            this.show()
            return tkinter_mainloop(this.window_id)
        }
        print("tkinter no disponible en runtime actual")
        return false
    }

    func run(width, height) {
        if not this.ensure(width, height) {
            return false
        }
        return this.mainloop()
    }
}
