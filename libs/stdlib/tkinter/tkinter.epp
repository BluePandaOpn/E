import _native

func available() {
    return tkinter_available()
}

func is_available() {
    return available()
}

class TkApp {
    func init(title) {
        this.app_title = title
        this.ready = available()
    }

    func ok() {
        return this.ready
    }

    func mainloop() {
        if this.ready {
            return true
        }
        print("tkinter no disponible en runtime actual")
        return false
    }
}

func Tk() {
    return TkApp("E++ App")
}

func app(title) {
    return TkApp(title)
}



// Extensiones utilitarias
func window(title) {
    return app(title)
}

func create_app(title) {
    return app(title)
}

func can_use() {
    return is_available()
}
