import _native

class HTTPRequest {
    func init(client_id) {
        this.client_id = int(client_id)
        this.method = http_request_method(this.client_id)
        this.path = http_request_path(this.client_id)
        this.version = http_request_version(this.client_id)
        this.body = http_request_body(this.client_id)
        this.raw = http_request_line(this.client_id)
    }

    func header(name) {
        return http_request_header(this.client_id, name)
    }
}

class HTTPResponse {
    func init(client_id) {
        this.client_id = int(client_id)
        this.closed = false
    }

    func send(body) {
        return this.send_status(200, "OK", "text/plain; charset=utf-8", body)
    }

    func text(body) {
        return this.send(body)
    }

    func json(body) {
        return this.send_status(200, "OK", "application/json; charset=utf-8", body)
    }

    func html(body) {
        return this.send_status(200, "OK", "text/html; charset=utf-8", body)
    }

    func send_status(code, status, content_type, body) {
        if this.closed {
            return false
        }
        var ok = http_response_send(this.client_id, int(code), status, content_type, body)
        this.closed = true
        return ok
    }

    func close() {
        if not this.closed {
            http_client_close(this.client_id)
            this.closed = true
        }
        return true
    }

    func not_found(body) {
        return this.send_status(404, "Not Found", "text/plain; charset=utf-8", body)
    }

    func bad_request(body) {
        return this.send_status(400, "Bad Request", "text/plain; charset=utf-8", body)
    }

    func internal_error(body) {
        return this.send_status(500, "Internal Server Error", "text/plain; charset=utf-8", body)
    }
}

class HTTPServer {
    func init(port) {
        this.host = "0.0.0.0"
        this.port = int(port)
        this.handle = http_server_listen(this.host, this.port)
    }

    func listen(host, port) {
        if this.handle > 0 {
            http_server_close(this.handle)
        }
        this.host = host
        this.port = int(port)
        this.handle = http_server_listen(this.host, this.port)
        return this.handle > 0
    }

    func ok() {
        return this.handle > 0
    }

    func accept_client() {
        return http_server_accept(this.handle)
    }

    func accept() {
        return this.accept_client()
    }

    func reopen(port) {
        return this.listen(this.host, port)
    }

    func close() {
        if this.handle > 0 {
            http_server_close(this.handle)
            this.handle = 0
        }
        return true
    }
}

func server(port) {
    return HTTPServer(port)
}

func create_server(port) {
    return server(port)
}

func request(client_id) {
    return HTTPRequest(client_id)
}

func response(client_id) {
    return HTTPResponse(client_id)
}

// Compatibilidad con API previa.
func get() { return http_get() }

func serve_once(port, body) {
    return http_server_once(port, body)
}

func serve_once_status(port, body, status) {
    return http_server_once(port, body, status)
}

func serve(port, body, max_requests) {
    return http_server_loop(port, body, max_requests)
}

func serve_status(port, body, max_requests, status) {
    return http_server_loop(port, body, max_requests, status)
}

func serve_forever(port, body) {
    return http_server_loop(port, body, 0)
}

func serve_forever_status(port, body, status) {
    return http_server_loop(port, body, 0, status)
}

// Extensiones utilitarias
func text_ok(client_id, body) {
    return response(client_id).send(body)
}

func json_ok(client_id, body) {
    return response(client_id).json(body)
}

func html_ok(client_id, body) {
    return response(client_id).html(body)
}

func module_name() {
    return "stdlib.http"
}

func module_version() {
    return "2.0.0"
}

func native_runtime() {
    return _native.runtime_name()
}

func native_builtin_mode() {
    return _native.builtin_mode()
}